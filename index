    --bg:#FAFAF7;
    --bg-soft:#F1EFE7;
    --ink:#14213D;
    --ink-soft:#5B6478;
    --coral:#FF5A5F;
    --coral-deep:#C0292E;
    --coral-tint: rgba(255,90,95,0.10);
    --teal:#00B8A2;
    --teal-deep:#0B7A6C;
    --teal-tint: rgba(0,184,162,0.10);
    --amber:#FFB627;
    --amber-deep:#9A6B00;
    --line: rgba(20,33,61,0.12);
    --line-soft: rgba(20,33,61,0.07);
    --shadow: 0 20px 50px rgba(20,33,61,0.08);
    --maxw: 1120px;
  }

  *{ box-sizing:border-box; }
  html{ scroll-behavior:smooth; }
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    -webkit-font-smoothing:antialiased;
    line-height:1.6;
  }

  h1,h2,h3{
    font-family:'Space Grotesk', sans-serif;
    color:var(--ink);
    margin:0;
    letter-spacing:-0.01em;
  }

  .mono{
    font-family:'IBM Plex Mono', monospace;
  }

  .wrap{
    max-width:var(--maxw);
    margin:0 auto;
    padding:0 24px;
  }

  a{ color:inherit; text-decoration:none; }

  .eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:12.5px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--teal-deep);
    margin:0 0 14px 0;
    display:flex;
    align-items:center;
    gap:10px;
  }
  .eyebrow::before{
    content:'';
    width:18px; height:2px;
    background:var(--coral);
    display:inline-block;
  }

  /* ---------- focus & motion ---------- */
  a:focus-visible, button:focus-visible{
    outline:2px solid var(--teal-deep);
    outline-offset:3px;
    border-radius:4px;
  }
  @media (prefers-reduced-motion: reduce){
    *{ animation:none !important; transition:none !important; }
  }

  /* ---------- nav ---------- */
  header.nav{
    position:sticky; top:0; z-index:50;
    background:rgba(250,250,247,0.92);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line-soft);
  }
  .nav-inner{
    max-width:var(--maxw);
    margin:0 auto;
    padding:16px 24px;
    display:flex;
    align-items:center;
    justify-content:space-between;
  }
  .logo{
    display:flex; align-items:center; gap:12px;
    font-family:'Space Grotesk', sans-serif;
    font-weight:700;
    font-size:15px;
  }
  .logo-badge{
    width:34px; height:34px;
    border-radius:9px;
    background:linear-gradient(135deg, var(--coral), var(--teal));
    color:#fff;
    display:flex; align-items:center; justify-content:center;
    font-size:13px; font-weight:700;
    letter-spacing:0.02em;
  }
  nav.links{
    display:flex; gap:28px;
    font-size:14.5px;
    font-weight:500;
    color:var(--ink-soft);
  }
  nav.links a:hover{ color:var(--ink); }
  .nav-cta{
    background:var(--ink);
    color:#fff;
    padding:9px 18px;
    border-radius:7px;
    font-size:14px;
    font-weight:600;
    white-space:nowrap;
  }
  .nav-cta:hover{ background:var(--coral-deep); }
  @media (max-width:760px){
    nav.links{ display:none; }
  }

  /* ---------- hero ---------- */
  .hero{
    padding:88px 0 40px;
  }
  .hero-eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:13px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--teal-deep);
    margin-bottom:18px;
  }
  .hero h1{
    font-size:clamp(40px, 6vw, 72px);
    font-weight:700;
    line-height:1.04;
    max-width:880px;
  }
  .hero p.sub{
    font-size:clamp(17px, 2vw, 20px);
    color:var(--ink-soft);
    max-width:640px;
    margin:22px 0 0;
  }

  .pulse-chart{ width:100%; height:auto; display:block; margin:48px 0 8px; }
  .pulse-line{
    fill:none;
    stroke:var(--coral);
    stroke-width:3;
    stroke-linecap:round;
    stroke-linejoin:round;
    stroke-dasharray:1600;
    stroke-dashoffset:1600;
    animation:draw 2.4s ease-out 0.2s forwards;
  }
  @keyframes draw{ to{ stroke-dashoffset:0; } }
  .bar{
    fill:var(--teal);
    opacity:0.22;
    transform-origin:bottom;
    transform:scaleY(0);
    animation:rise 0.6s ease-out forwards;
  }
  @keyframes rise{ to{ transform:scaleY(1); } }
  .chart-label{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    letter-spacing:0.16em;
    fill:var(--ink-soft);
  }

  .badges{
    display:flex; flex-wrap:wrap; gap:12px;
    margin-top:8px;
  }
  .badge{
    display:inline-flex; align-items:center; gap:8px;
    padding:9px 16px;
    border-radius:99px;
    font-size:13.5px;
    font-weight:500;
  }
  .badge.coral{ background:var(--coral-tint); color:var(--coral-deep); }
  .badge.teal{ background:var(--teal-tint); color:var(--teal-deep); }
  .dot{
    width:7px; height:7px; border-radius:50%;
    background:currentColor;
    animation:blink 2s ease-in-out infinite;
  }
  @keyframes blink{ 0%,100%{opacity:1;} 50%{opacity:0.35;} }

  .cta-row{
    display:flex; gap:14px; flex-wrap:wrap;
    margin-top:32px;
  }
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:13px 24px;
    border-radius:8px;
    font-weight:600;
    font-size:15px;
    transition:transform 0.15s ease, background 0.15s ease;
  }
  .btn.primary{ background:var(--coral-deep); color:#fff; }
  .btn.primary:hover{ background:#a5181d; transform:translateY(-1px); }
  .btn.ghost{ border:1.5px solid var(--line); color:var(--ink); }
  .btn.ghost:hover{ border-color:var(--ink); transform:translateY(-1px); }

  /* ---------- section base ---------- */
  .section{ padding:100px 0; }
  .section.tight{ padding:70px 0; }
  .section-head{ max-width:680px; margin-bottom:56px; }
  .section-head h2{ font-size:clamp(28px,3.4vw,40px); font-weight:700; }

  /* ---------- about ---------- */
  .about-grid{
    display:grid;
    grid-template-columns:280px 1fr;
    gap:64px;
    align-items:start;
  }
  .about-photo-wrap{
    width:100%;
    max-width:240px;
    border-radius:18px;
    padding:4px;
    background:linear-gradient(135deg, var(--coral), var(--teal));
    margin-bottom:28px;
  }
  .about-photo{
    display:block;
    width:100%;
    aspect-ratio:4/5;
    object-fit:cover;
    border-radius:14px;
    background:#fff;
  }
  .vitals{
    display:flex; flex-direction:column; gap:24px;
    border-left:2px solid var(--line);
    padding-left:24px;
  }
  .vital-stat .num{
    font-family:'IBM Plex Mono', monospace;
    font-size:26px;
    font-weight:500;
    color:var(--ink);
  }
  .vital-stat .num.amber{ color:var(--amber-deep); }
  .vital-stat .num.coral{ color:var(--coral-deep); }
  .vital-stat .num.teal{ color:var(--teal-deep); }
  .vital-stat .cap{
    font-size:13px;
    color:var(--ink-soft);
    margin-top:2px;
  }
  .about-copy p{
    font-size:17px;
    color:var(--ink-soft);
    margin:0 0 18px;
    max-width:620px;
  }
  .about-copy strong{ color:var(--ink); font-weight:600; }

  @media (max-width:820px){
    .about-grid{ grid-template-columns:1fr; gap:36px; }
    .vitals{ border-left:none; border-top:2px solid var(--line); padding-left:0; padding-top:24px; flex-direction:row; flex-wrap:wrap; gap:32px; }
  }

  /* ---------- skills ---------- */
  .skill-cols{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:40px;
  }
  .skill-col h3{
    font-size:15px;
    font-family:'IBM Plex Mono', monospace;
    text-transform:uppercase;
    letter-spacing:0.08em;
    margin-bottom:16px;
  }
  .skill-col.clin h3{ color:var(--coral-deep); }
  .skill-col.tech h3{ color:var(--teal-deep); }
  .pillset{ display:flex; flex-wrap:wrap; gap:10px; }
  .pill{
    padding:8px 14px;
    border-radius:99px;
    font-size:13.5px;
    font-weight:500;
    border:1.5px solid;
  }
  .pill.clin{ border-color:rgba(255,90,95,0.35); color:var(--coral-deep); background:var(--coral-tint); }
  .pill.tech{ border-color:rgba(0,184,162,0.35); color:var(--teal-deep); background:var(--teal-tint); }
  @media (max-width:700px){ .skill-cols{ grid-template-columns:1fr; gap:32px; } }

  /* ---------- work / case studies ---------- */
  .work-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:28px;
  }
  .case-card{
    background:#fff;
    border:1px solid var(--line);
    border-radius:16px;
    padding:36px;
    box-shadow:var(--shadow);
  }
  .case-tag{
    font-family:'IBM Plex Mono', monospace;
    font-size:11.5px;
    letter-spacing:0.12em;
    text-transform:uppercase;
    color:var(--ink-soft);
  }
  .case-stat{
    font-family:'IBM Plex Mono', monospace;
    font-size:44px;
    font-weight:500;
    margin:14px 0 2px;
    line-height:1;
  }
  .case-stat.amber{ color:var(--amber-deep); }
  .case-stat.coral{ color:var(--coral-deep); }
  .case-stat-cap{ font-size:13.5px; color:var(--ink-soft); margin-bottom:24px; }
  .case-card h3{ font-size:21px; margin-bottom:14px; }
  .case-row{ margin-bottom:14px; }
  .case-row .k{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--ink-soft);
    display:block;
    margin-bottom:4px;
  }
  .case-row p{ margin:0; font-size:15px; color:var(--ink); }

  .impact-strip{
    margin-top:28px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
  }
  .impact-item{
    border:1px solid var(--line);
    border-radius:14px;
    padding:24px;
    background:var(--bg-soft);
  }
  .impact-item .num{ font-family:'IBM Plex Mono', monospace; font-weight:500; font-size:22px; color:var(--teal-deep); }
  .impact-item p{ margin:8px 0 0; font-size:14.5px; color:var(--ink-soft); }

  @media (max-width:820px){
    .work-grid{ grid-template-columns:1fr; }
    .impact-strip{ grid-template-columns:1fr; }
  }

  /* ---------- timeline ---------- */
  .timeline{ position:relative; padding-left:36px; }
  .timeline::before{
    content:'';
    position:absolute; left:6px; top:6px; bottom:6px;
    width:2px;
    background:linear-gradient(to bottom, var(--coral), var(--teal));
    opacity:0.4;
  }
  .t-item{ position:relative; padding-bottom:42px; }
  .t-item:last-child{ padding-bottom:0; }
  .t-item::before{
    content:'';
    position:absolute; left:-36px; top:4px;
    width:13px; height:13px;
    border-radius:50%;
    background:var(--bg);
    border:2.5px solid var(--coral);
  }
  .t-item.tech-node::before{ border-color:var(--teal); }
  .t-date{
    font-family:'IBM Plex Mono', monospace;
    font-size:12.5px;
    color:var(--ink-soft);
    letter-spacing:0.04em;
    margin-bottom:4px;
  }
  .t-item h3{ font-size:18px; margin-bottom:4px; }
  .t-org{ font-size:14px; color:var(--ink-soft); margin-bottom:8px; }
  .t-item p.desc{ font-size:14.5px; color:var(--ink); max-width:600px; margin:0; }

  /* ---------- education / affiliations ---------- */
  .ed-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:48px;
  }
  .ed-col h3{
    font-family:'IBM Plex Mono', monospace;
    font-size:13px;
    text-transform:uppercase;
    letter-spacing:0.08em;
    color:var(--ink-soft);
    margin-bottom:18px;
  }
  .ed-item{ margin-bottom:18px; }
  .ed-item .t{ font-weight:600; font-size:15.5px; }
  .ed-item .s{ font-size:14px; color:var(--ink-soft); }
  @media (max-width:700px){ .ed-grid{ grid-template-columns:1fr; gap:32px; } }

  /* ---------- contact / footer ---------- */
  .contact{
    background:var(--ink);
    color:#fff;
    padding:96px 0 48px;
  }
  .contact h2{
    color:#fff;
    font-size:clamp(32px,4.2vw,52px);
    max-width:600px;
  }
  .contact p.sub{
    color:rgba(255,255,255,0.65);
    max-width:540px;
    font-size:17px;
    margin:18px 0 36px;
  }
  .contact-grid{
    display:flex; flex-wrap:wrap; gap:40px;
    margin-bottom:56px;
  }
  .contact-item .k{
    font-family:'IBM Plex Mono', monospace;
    font-size:11.5px;
    text-transform:uppercase;
    letter-spacing:0.1em;
    color:var(--teal);
    margin-bottom:6px;
    display:block;
  }
  .contact-item a, .contact-item span{
    font-size:16px;
    font-weight:500;
  }
  .contact-item a:hover{ color:var(--coral); }
  .foot-line{
    border-top:1px solid rgba(255,255,255,0.12);
    padding-top:24px;
    display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px;
    font-size:13px;
    color:rgba(255,255,255,0.45);
  }

  /* ---------- reveal ---------- */
  .reveal{ opacity:0; transform:translateY(18px); transition:opacity 0.6s ease, transform 0.6s ease; }
  .reveal.visible{ opacity:1; transform:translateY(0); }
</style>
